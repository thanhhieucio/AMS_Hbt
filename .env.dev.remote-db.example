# Copy this file to .env.dev.remote-db and fill in the real database username/password.
APP_ENV=develop
APP_DEBUG=true
APP_KEY=copy-your-local-app-key-here
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=vi-VN

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3307
DB_DATABASE=hsb_it
DB_USERNAME=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_PREFIX=null
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SSL=false

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDR=local@hsb-it.test
MAIL_FROM_NAME=HSB-IT
MAIL_REPLYTO_ADDR=local@hsb-it.test
MAIL_REPLYTO_NAME=HSB-IT